{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bbjavdb",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "vars": {
    "UPSTREAM_ORIGIN": "https://catembylegacy.fastcdn.dpdns.org",
    "EMBY_SERVER_VERSION": "4.8.0.0",
    "EMBY_GUEST_ACCESS": "true",
    "PLAYBACK_DEPLOY_TAG": "worker"
  },
  "d1_databases": [
    {
      "binding": "PLAYBACK_DB",
      "database_name": "ts-javdb-playback",
      "database_id": "e56f98c9-9460-47c8-ad81-cd24c56a3d9a"
    }
  ]
}
